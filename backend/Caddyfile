{
	skip_install_trust
	frankenphp
	order php_server before file_server
}

# Railway sets PORT. Fallback 8080 for local `docker run`.
:{$PORT:8080} {
	root * /app
	encode zstd gzip
	# Railway sets env on the container; FrankenPHP needs explicit pass-through for PHP to see it.
	php_server {
		env GITHUB_WEBHOOK_SECRET "{$GITHUB_WEBHOOK_SECRET}"
	}
	file_server
}
