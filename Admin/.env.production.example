# Copy to `.env.production` before `npm run build` when deploying under XAMPP htdocs.

# Backend URL (no trailing slash) — same as backend README for XAMPP.
VITE_BACKEND_URL=http://localhost/devflow-backend/backend

# If the Admin app lives in a subfolder of htdocs, set the URL path with leading and trailing slash.
# Example: app at http://localhost/devflow-admin/  →  use:
# VITE_PUBLIC_BASE=/devflow-admin/
# Leave unset or use / for dev (vite dev server at project root).

VITE_PUBLIC_BASE=/devflow-admin/

# Optional TURN relay for reliable WebRTC calls across different networks.
# Set these in your deployment platform too; Vite embeds them at build time.
VITE_TURN_URL=turn:your-turn-server.example.com:3478
VITE_TURN_USERNAME=your-turn-username
VITE_TURN_CREDENTIAL=your-turn-password
